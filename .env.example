# Salin menjadi .env lalu sesuaikan. Semua nilai di bawah adalah contoh untuk pengembangan lokal.

# --- Parameter model ---
PARAMS_FILE=config/params.json
PARAMS_PRESET=base
# manual atau ocr_llm
KEJADIAN_METODE=manual
# gpm_imerg, gsmap, atau nasa_power (cadangan otomatis bila sumber aktif tidak tersedia)
SUMBER_HUJAN_HULU=gpm_imerg
DATA_DIR=data/processed
SIM_SEED=42

# --- Akun awal dashboard (ganti di luar demo) ---
ADMIN_USER=admin
ADMIN_PASSWORD=admin

# --- Database (docker compose) ---
POSTGRES_USER=sigap
POSTGRES_PASSWORD=sigap
POSTGRES_DB=sigap
POSTGRES_PORT=5432
DATABASE_URL=postgresql://sigap:sigap@localhost:5432/sigap
DATABASE_URL_TEST=postgresql://sigap:sigap@localhost:5432/sigap_test

# --- API ---
API_PORT=8765

# --- Keamanan API ---
JWT_SECRET=ganti-dengan-string-acak-panjang
JWT_MENIT_KEDALUWARSA=480
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Kredensial sumber data (opsional; kosong = sumber dilewati, pakai cadangan berlabel) ---
EARTHDATA_TOKEN=
JAXA_USER=
JAXA_PASSWORD=

# --- Metode katalog ocr_llm (opsional) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
TESSERACT_CMD=
